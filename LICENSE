<script>
  // ambient starfield
  const starsContainer = document.getElementById('stars');
  const starCount = window.innerWidth < 640 ? 45 : 90;
  for (let i = 0; i < starCount; i++) {
    const s = document.createElement('div');
    s.className = 'star';
    const size = Math.random() * 1.8 + 0.6;
    s.style.width = size + 'px';
    s.style.height = size + 'px';
    s.style.top = Math.random() * 100 + '%';
    s.style.left = Math.random() * 100 + '%';
    s.style.animationDelay = (Math.random() * 5) + 's';
    s.style.animationDuration = (4 + Math.random() * 4) + 's';
    starsContainer.appendChild(s);
  }

  // orbit dot drifting along the hero cue, once settled
  const dot = document.getElementById('orbit-dot');
  if (dot && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let x = 4;
    const animateDot = () => {
      x += 0.4;
      if (x > 180) x = 4;
      dot.setAttribute('cx', x);
      requestAnimationFrame(animateDot);
    };
    setTimeout(() => requestAnimationFrame(animateDot), 1400);
  }
</script>

